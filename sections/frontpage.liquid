{% comment %}
  Frontpage section with featured products and categories
{% endcomment %}

<div class="min-h-screen bg-background">
  <!-- Welcome Section -->
  <section class="p-4 md:p-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-2">
          Welcome to VIBE SHOP
        </h1>
        <p class="text-muted-foreground text-lg">
          Discover premium bags and accessories
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Section -->
  <section class="p-4 md:p-6 mb-8">
    <div class="max-w-7xl mx-auto">
      <div class="gradient-card rounded-xl p-6 md:p-8 mb-8">
        <div class="text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-card-foreground mb-4">
            Featured Collection
          </h2>
          <p class="text-muted-foreground mb-6">
            Handpicked premium bags for the modern lifestyle
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Selector -->
  <section class="p-4 md:p-6 mb-8">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-xl font-bold text-foreground mb-4">Shop by Category</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {% for collection in collections limit: 4 %}
          <a href="{{ collection.url }}" class="gradient-card rounded-lg p-4 text-center hover:shadow-card transition-all duration-300">
            <div class="aspect-square bg-muted/20 rounded-lg mb-3 flex items-center justify-center">
              {% if collection.image %}
                <img src="{{ collection.image | img_url: '200x200' }}" alt="{{ collection.title }}" class="w-full h-full object-cover rounded-lg">
              {% else %}
                <svg class="h-12 w-12 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
              {% endif %}
            </div>
            <h3 class="font-semibold text-foreground">{{ collection.title }}</h3>
            <p class="text-sm text-muted-foreground">{{ collection.products_count }} products</p>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Popular Products -->
  <section class="p-4 md:p-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-foreground">Popular Products</h2>
        <a href="{{ routes.collections_url }}" class="text-primary hover:text-primary/80 font-medium">
          See All
        </a>
      </div>

      <!-- Product Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {% for product in collections.all.products limit: 6 %}
          <div class="gradient-card rounded-lg overflow-hidden hover:shadow-card hover:scale-[1.02] transition-all duration-300">
            <div class="relative aspect-square overflow-hidden">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  <img 
                    src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" 
                    alt="{{ product.title }}"
                    class="w-full h-full object-cover hover:scale-110 transition-transform duration-500"
                  >
                {% else %}
                  <div class="w-full h-full bg-muted/20 flex items-center justify-center">
                    <svg class="h-16 w-16 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                {% endif %}
              </a>
              
              {% if product.compare_at_price > product.price %}
                <div class="absolute top-3 left-3 bg-gradient-accent text-white px-2 py-1 rounded-full text-xs font-medium">
                  Sale
                </div>
              {% endif %}
            </div>
            
            <div class="p-4">
              <h3 class="font-semibold text-foreground mb-2">
                <a href="{{ product.url }}" class="hover:text-primary transition-colors">
                  {{ product.title }}
                </a>
              </h3>
              
              <!-- Rating -->
              <div class="flex items-center mb-3">
                <div class="flex items-center">
                  {% for i in (1..5) %}
                    <svg class="h-4 w-4 {% if i <= 4 %}text-yellow-400{% else %}text-muted-foreground{% endif %}" fill="{% if i <= 4 %}currentColor{% else %}none{% endif %}" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                    </svg>
                  {% endfor %}
                </div>
                <span class="text-sm text-muted-foreground ml-2">({{ product.reviews_count | default: 0 }})</span>
              </div>
              
              <!-- Price and Add to Cart -->
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <span class="text-lg font-bold text-primary">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="text-sm text-muted-foreground line-through">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
                
                <form action="/cart/add" method="post" class="inline">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button 
                    type="submit" 
                    class="gradient-primary text-primary-foreground px-3 py-2 rounded-lg text-sm font-medium hover:shadow-glow transition-all duration-300 touch-target"
                    {% unless product.available %}disabled{% endunless %}
                  >
                    {% if product.available %}
                      <svg class="h-4 w-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                      </svg>
                      Add to Cart
                    {% else %}
                      Sold Out
                    {% endif %}
                  </button>
                </form>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>