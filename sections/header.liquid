{% comment %}
  Header section with search, cart, and navigation
{% endcomment %}

<header class="bg-card/50 backdrop-blur-sm border-b border-border p-4 md:p-6">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between">
      <!-- Logo and Brand -->
      <div class="flex items-center space-x-4">
        <a href="{{ routes.root_url }}" class="text-2xl font-bold text-foreground">
          VIBE SHOP
        </a>
      </div>

      <!-- Search Bar -->
      <div class="flex-1 max-w-md mx-4 hidden md:block">
        <form action="{{ routes.search_url }}" method="get" class="relative">
          <input 
            type="search" 
            name="q" 
            placeholder="Search products..." 
            class="w-full pl-10 pr-10 py-2 bg-secondary/50 border border-border rounded-lg text-foreground placeholder-muted-foreground"
            value="{{ search.terms | escape }}"
          >
          <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <button type="submit" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-muted-foreground h-4 w-4">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.207A1 1 0 013 6.5V4z"></path>
            </svg>
          </button>
        </form>
      </div>

      <!-- Right side actions -->
      <div class="flex items-center space-x-4">
        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="relative touch-target">
          <svg class="h-6 w-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5M7 13l2.5 5m6-5v6a2 2 0 01-2 2H9a2 2 0 01-2-2v-6m8 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01"></path>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="absolute -top-1 -right-1 h-5 w-5 bg-accent text-accent-foreground rounded-full text-xs font-medium flex items-center justify-center">
              {{ cart.item_count }}
            </span>
          {% endif %}
        </a>

        <!-- Notifications -->
        <button class="relative touch-target">
          <svg class="h-6 w-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-5 5v-5zM4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"></path>
          </svg>
          <span class="absolute -top-1 -right-1 h-3 w-3 bg-accent rounded-full"></span>
        </button>

        <!-- Account -->
        {% if customer %}
          <a href="{{ routes.account_url }}" class="w-8 h-8 gradient-primary rounded-full flex items-center justify-center">
            <span class="text-primary-foreground text-sm font-medium">{{ customer.first_name | slice: 0, 1 | upcase }}</span>
          </a>
        {% else %}
          <a href="{{ routes.account_login_url }}" class="w-8 h-8 gradient-primary rounded-full flex items-center justify-center">
            <span class="text-primary-foreground text-sm font-medium">G</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</header> 